# Copy to .env and fill in. Never commit .env. Both keys are optional; LeadDesk works fully local without them.
# NVIDIA Nemotron models on Nebius Token Factory (https://tokenfactory.nebius.com): used only after you choose a Token Factory model in the app.
NEBIUS_API_KEY=
# Tavily web search (https://tavily.com): used only after you turn it on in Find clients.
TAVILY_API_KEY=
# Public demo only:
# LEADDESK_DEMO=1
# LEADDESK_PUBLIC_HOST=demo.your-domain.com
# LEADDESK_DEMO_AI_PER_HOUR=30
